+// Synchronous archive loader. The normal GGUF parser still chooses every tensor's type, shape and allocation.
+using ternzip_writer = int (*)(void *, const char *, void *, size_t, int, const char *, ggml_tensor *);
+struct ternzip_load_scope {
+    ternzip_writer write;
+    void * user;
+};
+static thread_local ternzip_load_scope direct_writer = {};
+
+extern "C" LLAMA_API llama_model * ternzip9_load_with_writer(FILE * file, llama_model_params params,
+        ternzip_writer write, void * user) {
+    if (!file || !write || direct_writer.write) return nullptr;
+    struct reset_writer { ~reset_writer() { direct_writer = {}; } } reset;
+    direct_writer = {write, user};
+    return llama_model_load_from_file_ptr(file, params);
+}
