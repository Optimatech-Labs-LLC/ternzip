@@ -2,6 +2,93 @@
 #include "llama-impl.h"
 #include "llama-memory-recurrent.h"
 #include "llama-kv-cache.h"
+// Private, single-chat Metal graph specializations for the pinned Qwen3.5 runtime.
+#include <atomic>
+
+namespace {
+enum reuse_feature { snapshot = 1, conv_history = 2, no_empty_state = 4 };
+std::atomic<unsigned> reuse_flags{0};
+std::atomic<uint64_t> marked_states{0};
+std::atomic<uint64_t> direct_histories{0}, wide_convolutions{0};
+
+bool reads_snapshot(const ggml_tensor * t, const ggml_tensor * gdn, size_t prefix) {
+    return t && (t == gdn || (t->view_src == gdn && t->view_offs + ggml_nbytes(t) > prefix));
+}
+
+bool is_view_only(ggml_op op) {
+    return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE ||
+           op == GGML_OP_TRANSPOSE || op == GGML_OP_PERMUTE;
+}
+
+// The standard GDN result is [attention | snapshot]. The ordinary scatter stays in
+// the graph. Metal may omit the snapshot store only when it actually folds that
+// scatter into GDN. A backend that does not fold it produces the ordinary snapshot.
+void mark_single_use_snapshots(ggml_cgraph * graph) {
+    const int count = ggml_graph_n_nodes(graph);
+    for (int i = 0; i < count; ++i) {
+        ggml_tensor * gdn = ggml_graph_node(graph, i);
+        if (gdn->op != GGML_OP_GATED_DELTA_NET || gdn->op_params[0] != 1 ||
+                !gdn->src[6] || (gdn->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            continue;
+        }
+        const ggml_tensor * v = gdn->src[2];
+        ggml_tensor * q = gdn->src[0];
+        if (v->ne[2] != 1 || v->ne[3] != 1 || q->ne[3] != 1 || q->op != GGML_OP_VIEW) {
+            continue;
+        }
+        const size_t prefix = size_t(v->ne[0]) * v->ne[1] * sizeof(float);
+        const size_t state_bytes = size_t(v->ne[0]) * prefix;
+        if (ggml_nbytes(gdn) != prefix + state_bytes) {
+            continue;
+        }
+        unsigned scatters = 0;
+        bool safe = true;
+        for (int j = i + 1; safe && j < count; ++j) {
+            const ggml_tensor * consumer = ggml_graph_node(graph, j);
+            if (reads_snapshot(consumer, gdn, prefix) && (consumer->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                safe = false;
+                break;
+            }
+            if (is_view_only(consumer->op)) {
+                continue;
+            }
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                const ggml_tensor * input = consumer->src[s];
+                if (!reads_snapshot(input, gdn, prefix)) {
+                    continue;
+                }
+                if (s == 0 && consumer->op == GGML_OP_SET_ROWS && input->view_src == gdn &&
+                        input->view_offs == prefix && ggml_is_contiguous(input) &&
+                        ggml_nbytes(input) == state_bytes && consumer->src[1]->type == GGML_TYPE_I64) {
+                    ++scatters;
+                } else {
+                    safe = false;
+                    break;
+                }
+            }
+        }
+        if (safe && scatters == 1) {
+            // A singleton sequence dimension has no second address. A zero batch
+            // stride explicitly declares this private view broadcast over that axis.
+            // The paired shader recognizes it only on a real one-sequence folded op.
+            q->nb[3] = 0;
+            ++marked_states;
+        }
+    }
+}
+} // namespace
+
+extern "C" LLAMA_API void ternzip9_reuse_config(unsigned flags) {
+    reuse_flags.store(flags);
+    marked_states.store(0);
+    direct_histories.store(0); wide_convolutions.store(0);
+}
+
+extern "C" LLAMA_API uint64_t ternzip9_reuse_graph_count(int which) {
+    if (which == 2) return wide_convolutions.load();
+    return which == 0 ? marked_states.load() : direct_histories.load();
+}
